rules_version = '2';

// 교실 자리 배치 프로그램 Firestore 보안 규칙
//
// 이 파일은 2026-09-09 기준 Firebase 콘솔에 실제로 배포되어 있는 규칙과 동일하다.
// 규칙을 콘솔에서만 관리하면 버전 관리도, 코드 리뷰도, 변경 추적도 되지 않는다.
// 앞으로 규칙 변경은 이 파일을 고쳐서 배포한다.
//
// 배포:  firebase deploy --only firestore:rules
// 확인:  Firebase 콘솔 → Firestore Database → 규칙 탭

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 교사별 데이터 ────────────────────────────────────────────────
    // 학생 이름과 성별(미성년자 개인정보)이 이 아래에 저장되므로
    // 반드시 소유자 본인만 접근할 수 있어야 한다.
    // 클라이언트의 로그인 검사는 브라우저에서 우회 가능하므로 신뢰할 수 없다.

    // users/{userId}  →  반 목록(classList)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // users/{userId}/classes/{classId}  →  자리 배치도(students 포함)
    match /users/{userId}/classes/{classId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // users/{userId}/classes/{classId}/seatHistory/**  →  확정된 자리 이력
    match /users/{userId}/classes/{classId}/seatHistory/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── 방문자 카운터 ────────────────────────────────────────────────
    // 랜딩 페이지와 앱이 로그인 없이 읽고, 앱 진입 시 1 증가시킨다.
    // 익명 쓰기가 필요하지만 '무엇이든 허용'은 아니다.
    // create/update만 허용하므로 삭제는 불가능하다.
    match /globalStats/visitorCount {
      // 모든 사용자가 방문자 수 조회 가능
      allow read: if true;

      // 최초 문서 생성 시 count를 1로 시작
      allow create: if request.resource.data.count == 1;

      // 업데이트 시 기존 count에서 정확히 1만 증가 가능
      // (임의의 값으로 덮어쓰는 것을 막는다)
      allow update: if request.resource.data.count == resource.data.count + 1;
    }

    // 위에서 명시적으로 허용하지 않은 모든 경로는 Firestore 기본 정책에 따라 거부된다.
  }
}
