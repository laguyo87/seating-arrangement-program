rules_version = '2';

// 교실 자리 배치 프로그램 Firestore 보안 규칙
//
// 이 파일이 없으면 접근 통제가 클라이언트 코드의 로그인 검사뿐이다.
// 그 검사는 브라우저에서 실행되므로 콘솔에서 SDK를 직접 호출하면 우회된다.
// 학생 이름과 성별(미성년자 개인정보)이 저장되므로 서버 측 규칙이 반드시 필요하다.
//
// 배포:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 교사별 데이터 ────────────────────────────────────────────────
    // users/{userId}                                   반 목록(classList)
    // users/{userId}/classes/{classId}                 자리 배치도(students 포함)
    // users/{userId}/classes/{classId}/seatHistory/*   확정된 자리 이력
    //
    // 본인 소유 문서만 읽고 쓸 수 있다.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // 하위 컬렉션 전체에 동일 규칙 적용
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── 방문자 카운터 ────────────────────────────────────────────────
    // 랜딩 페이지와 앱이 로그인 없이 읽고, 앱 진입 시 1 증가시킨다.
    // 익명 쓰기가 필요하지만 '무엇이든 쓰기 허용'은 아니다.
    // 허용 조건: count 필드가 정확히 1 증가하고, 다른 필드는 추가되지 않을 것.
    match /globalStats/visitorCount {
      allow read: if true;

      allow write: if request.resource.data.keys().hasOnly(['count', 'lastUpdated'])
                   && request.resource.data.count is int
                   && (
                        // 최초 생성
                        (resource == null && request.resource.data.count == 1)
                        ||
                        // 1씩 증가만 허용 (임의의 값으로 덮어쓰기 차단)
                        (resource != null && request.resource.data.count == resource.data.count + 1)
                      );
    }

    // 그 외 globalStats 문서는 읽기만 허용
    match /globalStats/{document} {
      allow read: if true;
      allow write: if false;
    }

    // ── 기본 거부 ────────────────────────────────────────────────────
    // 위에서 명시적으로 허용하지 않은 모든 경로는 차단한다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
